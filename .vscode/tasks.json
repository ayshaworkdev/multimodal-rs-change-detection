{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Python dependencies",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Gemini few-shot detector",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "dotenv",
        "run",
        "--env-file",
        "${workspaceFolder}/.env",
        "--",
        "python",
        "-m",
        "multimodal_rs_change_detection.gemini_few_shot",
        "--num-samples",
        "15",
        "--output-dir",
        "${workspaceFolder}/results/few_shot_gemini",
        "--output-name",
        "gemini-fewshots-result1.json"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
